{
  "expo": {
    "name": "Bhasha Setu",
    "slug": "bhasha-setu",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F9F6F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bhashasetu.app"
    },
    "android": {
      "package": "com.bhashasetu.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bhasha Setu to access your photos for blackboard translation.",
          "cameraPermission": "Allow Bhasha Setu to access camera for blackboard OCR."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Bhasha Setu to access microphone for live classroom speech translation."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "076a5e1c-3f37-4bae-8b28-20846b141926"
      }
    }
  }
}
