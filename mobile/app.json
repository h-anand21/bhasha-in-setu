{
  "expo": {
    "name": "Bhasha Setu",
    "slug": "bhasha-setu",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F9F6F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bhashasetu.app"
    },
    "android": {
      "package": "com.bhashasetu.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bhasha Setu to access your photos for blackboard translation.",
          "cameraPermission": "Allow Bhasha Setu to access camera for blackboard OCR."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Bhasha Setu to access microphone for live classroom speech translation."
        }
      ]
    ]
  }
}
